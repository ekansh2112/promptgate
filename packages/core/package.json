{
  "name": "@promptgate/core",
  "version": "1.0.0",
  "description": "PromptGate core engine and CLI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "bin": {
    "promptgate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Linting temporarily disabled'",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "yaml": "^2.5.1",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.15",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "eslint": "^9.13.0"
  }
}
